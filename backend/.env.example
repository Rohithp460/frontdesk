PROJECT_NAME=Frontdesk API
ENVIRONMENT=development
# Generate a random secret of at least 32 characters before production deployment.
JWT_SECRET=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# MySQL Database Configuration
MYSQL_SERVER=mysql
MYSQL_PORT=3306
MYSQL_USER=frontdesk
MYSQL_PASSWORD=frontdesk_password
MYSQL_DB=frontdesk_db
DATABASE_URL=mysql+pymysql://frontdesk:frontdesk_password@mysql:3306/frontdesk_db

CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]
